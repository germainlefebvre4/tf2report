<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 538 276" width="538" height="276" role="img" font-family="ui-monospace, Menlo, Consolas, monospace" font-size="11">
<title>Terraform plan diagram</title>
<desc>3 resources: create 1, update 1, delete 1</desc>
<rect width="538" height="276" fill="#ffffff"/>
<defs>
